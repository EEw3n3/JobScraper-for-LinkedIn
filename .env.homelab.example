# Copy to .env.homelab; generate your own password before starting.
APP_UID=1000
APP_GID=1000
JOBPARSER_BIND_IP=127.0.0.1
JOBPARSER_WEB_USER=admin
# Intentionally invalid placeholder: web startup requires at least 16 characters.
JOBPARSER_WEB_PASSWORD=CHANGE_ME
# noVNC uses the first eight characters; generate a separate random value.
JOBPARSER_VNC_PASSWORD=CHANGE
JOBPARSER_NOVNC_URL=http://127.0.0.1:16080/vnc.html?autoconnect=true&resize=scale
JOBPARSER_INTERACTIVE_WAIT=300
# Optional AI analysis (leave blank to omit credentials).
GEMINI_API_KEY=
GEMINI_MODEL=
