# Copy this file to .env and fill in your own values. .env is git-ignored: never commit it.

# Google Gemini API key from https://aistudio.google.com/apikey (free tier works).
GEMINI_API_KEY=

# Optional: another Gemini model, for example gemini-3.5-flash on a paid key.
GEMINI_MODEL=

# Optional: seconds between Gemini requests. 4.0 keeps the free tier (15 requests per minute) happy;
# a paid key can go lower, for example 0.5.
GEMINI_MIN_INTERVAL=
